Package: SpatialAnalysisWorkshop
Title: Spatial transcriptomics downstream analysis with hoodscanR and scider
Version: 2.0.1
Authors@R:
    c(
      person(given = "Ning",
             family = "Liu",
             role = c("aut", "cre"),
             email = "ning.liu@adelaide.edu.au",
             comment = c(ORCID = "0000-0002-9487-9305"))
